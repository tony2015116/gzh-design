NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# 必须设为用户实际访问的域名，不能带路径。会用于生成图片 URL。
PUBLIC_URL=https://editor.example.com
DATA_DIR=./data
STATIC_DIR=../app/dist
# Debian Chromium 常见路径；不配置时信息图退回 SVG。
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
AI_FORMAT_LOG_LEVEL=basic
AI_MAX_INPUT_CHARS=30000
AI_DAILY_QUOTA_FREE=20
AI_DAILY_QUOTA_VIP=200
