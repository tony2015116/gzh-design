# Shared public env values for the frontend
VITE_WORKER_URL=https://your-worker.your-subdomain.workers.dev
VITE_WORKER_UPLOAD_SECRET=

# Build mode defaults
VITE_APP_MODE=oss
VITE_AUTH_MODE=mock
VITE_ACCESS_MODE=mock
VITE_DEV_USER_ROLE=vip
VITE_DEFAULT_UPLOAD_MODE=base64
VITE_OSS_AI_LOG_LEVEL=verbose
VITE_OSS_AI_LOG_PREVIEW_CHARS=240
