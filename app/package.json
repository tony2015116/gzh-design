    "lucide-react": "^0.577.0",
    "markdown-it": "^14.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.5",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
