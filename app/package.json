{
  "name": "luobo-gzh-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "build:skill": "node scripts/build-skill.mjs",
    "start:desktop": "electron .",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.577.0",
    "markdown-it": "^14.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.8"
  },
  "description": "Local Markdown editor and WeChat typesetting workbench",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.luobo.gzh.desktop",
    "productName": "公众号排版工作台",
    "executableName": "LuoboGzh",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LuoboGzh-Setup-${version}-${arch}.${ext}"
    }
  }
}
